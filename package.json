{
  "name": "astro-content-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "A content hub template: aggregate docs and posts from many open-source repos into one localized, auto-deployed static site.",
  "scripts": {
    "dev": "node scripts/ensure-pagefind-public.mjs && astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && npm run search:index",
    "search:index": "pagefind --site dist && node scripts/sync-pagefind-public.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "validate:content": "node skills/site-content/scripts/validate-hub-content.mjs",
    "check:upstream": "node scripts/check-upstream.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync:examples": "node scripts/sync-examples.mjs",
    "check:examples": "node scripts/check-examples.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awareride/astro-content-hub.git"
  },
  "keywords": [
    "astro",
    "content-hub",
    "static-site",
    "i18n",
    "documentation",
    "blog"
  ],
  "author": "awareride",
  "license": "MIT",
  "homepage": "https://awareride.github.io/astro-content-hub/",
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.1.1",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "postcss": "^8.5.24",
    "fast-uri": "^4.1.2"
  }
}
