---
// src/components/ProductBreadcrumb.astro
// Breadcrumb for product landing pages: Home / <product>. Rendered by the
// [product] route (and its [locale] twin) above the landing content, so it
// appears on every path (section-driven default, legacy fallback, and
// hand-written overrides alike). Mirrors the .docs-breadcrumb pattern.
import { t, type Locale, withBase } from '../lib/i18n';

interface Props {
  locale: Locale;
  productName: string;
}

const { locale, productName } = Astro.props;
const ui = t[locale];
const homeHref = withBase(locale === 'en' ? '/' : `/${locale}/`);
---

<nav class="product-breadcrumb" aria-label="Breadcrumb">
  <a href={homeHref}>{ui.home}</a> / <span>{productName}</span>
</nav>
