---
// src/components/ProductLandingDefault.astro
// Generic product landing. Rendered by the `[product]` route (and its
// [locale] twin) when a product has no override at
// `src/components/product-landing/<slug>.astro`. Shares the same prop
// contract as an override, so the route can swap them freely.
//
// Auto-generated mode: if a structured `product-info` file exists for this
// product + locale (with default-locale fallback) it is rendered as a rich
// landing (hero + tagline, highlights, install snippet, feature grid, an
// optional curated overview body, and a CTA). With no file, the minimal
// hero + CTA below is shown. A hand-written override always takes precedence
// over this component (the route resolves it first).
import type { Product } from '../config/products';
import type { Locale, ProductCopy } from '../lib/i18n';
import type { ProductLandingProps } from '../lib/product-landing';
import { getLocalizedProductInfo } from '../lib/content';

interface Props extends ProductLandingProps {}
const { product, locale, c, docsHref } = Astro.props as Props;

// Resolve landing info (null when no product-info file exists for this product).
const info = await getLocalizedProductInfo(product.slug, locale);
const tagline = info?.tagline;
const features = info?.features ?? [];
const highlights = info?.highlights ?? [];
const install = info?.install;
const links = info?.links ?? [];
const hasBody = info?.hasBody ?? false;
const Content = info?.Content;
---

{info ? (
  <Fragment>
    <section class="product-hero">
      <div class="container">
        <div class="hero-badge" style="display:inline-block; font-size:0.85rem; font-weight:600; padding:0.25rem 0.9rem; border-radius:100px; background:var(--color-accent-subtle); color:var(--color-accent); margin-bottom:1.25rem;">
          {c.heroBadge}
        </div>
        <h1>{product.name}</h1>
        <p class="hero-lead">{tagline}</p>
        <div class="hero-actions">
          <a href={product.github} class="btn btn-primary" target="_blank" rel="noopener">{c.viewSource}</a>
          <a href={docsHref} class="btn btn-secondary">{c.documentation}</a>
          {links.map((l) => (
            <a href={l.href} class="btn btn-secondary" target="_blank" rel="noopener">{l.label}</a>
          ))}
        </div>
      </div>
    </section>

    {highlights.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="product-highlights">
            {highlights.map((h) => (
              <div class="product-highlight">
                <div class="product-highlight-value">{h.value}</div>
                <div class="product-highlight-label">{h.label}</div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {install && (
      <section class="section section-alt">
        <div class="container">
          <div class="terminal product-install-terminal">
            <div class="terminal-header"><span></span><span></span><span></span></div>
            <div class="terminal-body"><code>{install}</code></div>
          </div>
        </div>
      </section>
    )}

    {features.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="feature-grid">
            {features.map((f) => (
              <div class="feature-card">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {hasBody && Content && (
      <section class="section section-alt">
        <div class="container">
          <div class="prose product-overview">
            <Content />
          </div>
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <div class="cta-box">
          <h2>{c.ctaTitle}</h2>
          <p>{c.ctaBody}</p>
          <div class="cta-actions">
            <a href={product.github} class="btn btn-primary btn-large" target="_blank" rel="noopener">{c.ctaPrimary}</a>
            <a href={docsHref} class="btn btn-secondary btn-large">{c.readDocs}</a>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
) : (
  <Fragment>
    <section class="product-hero">
      <div class="container">
        <div class="hero-badge" style="display:inline-block; font-size:0.85rem; font-weight:600; padding:0.25rem 0.9rem; border-radius:100px; background:var(--color-accent-subtle); color:var(--color-accent); margin-bottom:1.25rem;">
          {c.heroBadge}
        </div>
        <h1>{product.name}</h1>
        <div class="hero-actions">
          <a href={product.github} class="btn btn-primary" target="_blank" rel="noopener">{c.viewSource}</a>
          <a href={docsHref} class="btn btn-secondary">{c.documentation}</a>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-header">
          <p class="eyebrow">{c.docsEyebrow}</p>
          <h2>{c.docsTitle}</h2>
        </div>
        <div class="cta-box">
          <h2>{c.ctaTitle}</h2>
          <p>{c.ctaBody}</p>
          <div class="cta-actions">
            <a href={product.github} class="btn btn-primary btn-large" target="_blank" rel="noopener">{c.ctaPrimary}</a>
            <a href={docsHref} class="btn btn-secondary btn-large">{c.readDocs}</a>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
)}
