---
// src/components/landing-sections/cta.astro
// Landing section: closing CTA box (shared productCopy labels).
// Rendered by ProductLandingDefault via the section registry. Mirrors the
// original ProductLandingDefault CTA exactly (primary -> GitHub, secondary ->
// docs). ProductInfo CTA overrides (primary/secondary labels) arrive in Phase 3.
import type { LandingSectionProps } from '../../lib/landing-sections';

interface Props extends LandingSectionProps {}
const { product, c, docsHref } = Astro.props as Props;
---

<section class="section">
  <div class="container">
    <div class="cta-box">
      <h2>{c.ctaTitle}</h2>
      <p>{c.ctaBody}</p>
      <div class="cta-actions">
        <a href={product.github} class="btn btn-primary btn-large" target="_blank" rel="noopener">{c.ctaPrimary}</a>
        <a href={docsHref} class="btn btn-secondary btn-large">{c.readDocs}</a>
      </div>
    </div>
  </div>
</section>
