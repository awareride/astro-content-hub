---
// src/components/Footer.astro
// Locale is inferred from the URL pathname, matching Nav.
import { localeFromPath, localizePath, t, siteName, products } from '../lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
const ui = t[locale];
const homeHref = localizePath('/', locale);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <a href={homeHref} class="logo">
        <span class="logo-mark"><img src="/images/logo.png" alt="" width="28" height="28" /></span>
        <span class="logo-text">{siteName}</span>
      </a>
      <p class="footer-tagline">{ui.footerTagline}</p>
    </div>
    <div>
      <h4>{ui.links}</h4>
      <ul class="footer-links">
        <li><a href={homeHref}>{ui.home}</a></li>
        <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
    <div>
      <h4>{ui.projects}</h4>
      <ul class="footer-links">
        {products.map((p) => (
          <li><a href={localizePath(`/${p.slug}`, locale)}>{p.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4>{ui.connect}</h4>
      <ul class="footer-links">
        <li><a href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-bottom">
    <p>&copy; {new Date().getFullYear()} {siteName}. {ui.builtWith}</p>
  </div>
</footer>
