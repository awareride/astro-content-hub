---
// src/pages/zh/[product]/docs/index.astro
// Generic product docs overview page (locale: zh). URL: /zh/<slug>/docs
import DocsLayout from '../../../../components/DocsLayout.astro';
import { getLocalizedDocIndex } from '../../../../lib/content';
import { buildAlternates, localizePath, products } from '../../../../lib/i18n';

export function getStaticPaths() {
  return products.map((p) => ({
    params: { product: p.slug },
    props: { product: p.slug },
  }));
}

const { product } = Astro.props;
// Locale-aware base path for the sidebar nav (adds the /zh prefix for zh).
const basePath = localizePath(`/${product}/docs`, 'zh');
const page = await getLocalizedDocIndex(product, 'zh', basePath);
if (!page) return Astro.redirect(basePath);
const { Content, title, description, navItems, isFallback } = page;
// buildAlternates expects the default-locale (en) path.
const alternates = buildAlternates(`/${product}/docs`);
---

<DocsLayout
  title={title}
  description={description}
  sidebarTitle={`${product} Docs`}
  productName={product}
  productHref={`/${product}`}
  navItems={navItems}
  locale="zh"
  isFallback={isFallback}
  basePath={basePath}
  alternates={alternates}
>
  <Content />
</DocsLayout>
