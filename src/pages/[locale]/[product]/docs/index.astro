---
// src/pages/[locale]/[product]/docs/index.astro
// Product docs overview for non-default locales (e.g. /zh-Hans/vite/docs/).
// The default-locale route is src/pages/[product]/docs/index.astro.
import DocsLayout from '../../../../components/DocsLayout.astro';
import { getLocalizedDocIndex } from '../../../../lib/content';
import { buildAlternates, localizePath, withBase, defaultLocale, locales, type Locale } from '../../../../lib/i18n';
import { products } from '../../../../config/products';

export function getStaticPaths() {
  const paths: { params: { locale: Locale; product: string }; props: { product: string; locale: Locale } }[] = [];
  for (const l of locales) {
    if (l === defaultLocale) continue;
    for (const p of products) {
      paths.push({ params: { locale: l, product: p.slug }, props: { product: p.slug, locale: l } });
    }
  }
  return paths;
}

const { product, locale } = Astro.props;
const basePath = localizePath(`/${product}/docs`, locale);
const page = await getLocalizedDocIndex(product, locale, basePath);
if (!page) return Astro.redirect(withBase(basePath));
const { Content, title, description, navItems, isFallback, headings } = page;
const alternates = buildAlternates(`/${product}/docs`);
---

<DocsLayout
  title={title}
  description={description}
  sidebarTitle={`${product} Docs`}
  productName={product}
  productHref={`/${product}`}
  navItems={navItems}
  locale={locale}
  isFallback={isFallback}
  alternates={alternates}
  headings={headings}
>
  <Content />
</DocsLayout>
