---
// src/pages/posts/index.astro
// Blog listing page (default locale: en). Grouped by source directory.
import Layout from '../../components/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getLocalizedPosts } from '../../lib/content';
import { buildAlternates } from '../../lib/i18n';

const items = await getLocalizedPosts('en');
const sorted = items.sort(
  (a, b) => b.entry.data.date.getTime() - a.entry.data.date.getTime(),
);
const alternates = buildAlternates('/posts');

function dirname(id: string) {
  const parts = id.split('/');
  return parts.length > 1 ? parts.slice(0, -1).join('/') : null;
}
---

<Layout
  title="Posts"
  description="Technical articles from the content hub — guides, notes, and announcements."
  locale="en"
  alternates={alternates}
>
  <Nav alternates={alternates} />

  <main>
    <section class="hero" style="padding-bottom: 2rem;">
      <div class="container">
        <p class="eyebrow">Blog</p>
        <h1>Posts</h1>
        <p class="hero-lead" style="margin-top: 0.5rem;">
          Thoughts on developer tooling, bundle analysis, perception, and building with awareness.
        </p>
      </div>
    </section>

    <section class="section" style="padding-top: 1rem;">
      <div class="container">
        {
          sorted.length === 0 ? (
            <p style="text-align:center; color:var(--color-text-muted);">
              No posts yet. Check back soon.
            </p>
          ) : (
            <div class="posts-grid">
              {sorted.map(({ entry, isFallback }) => (
                <PostCard
                  title={entry.data.title}
                  date={entry.data.date}
                  description={entry.data.description}
                  tags={entry.data.tags}
                  slug={entry.id}
                  source={dirname(entry.id)}
                  isFallback={isFallback}
                  locale="en"
                />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>

  <Footer />
</Layout>
